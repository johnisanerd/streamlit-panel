# SuggesMe — Ortam Değişkenleri
# Kullanım: cp .env.example .env  (ardından .env dosyasını düzenle)
# NOT: .env asla git'e eklenmez (.gitignore'da kayıtlı olmalı)

# ── Uygulama ──────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_DEBUG=true
APP_NAME=SuggesMe

# ── Veritabanı ────────────────────────────────────────────────────────────────
# Boş bırakılırsa config.py proje kökünden otomatik yol hesaplar
DATABASE_URL=

# ── Loglama ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/suggesme.log

# ── n8n Kampanya Otomasyonu ───────────────────────────────────────────────────
# Boş bırakılırsa uygulama demo modda çalışır (payload ekranda gösterilir)
N8N_WEBHOOK_URL=

# ── Apify Entegrasyonu ────────────────────────────────────────────────────────
# Boş bırakılırsa tüm Apify özellikleri demo modda çalışır
APIFY_API_TOKEN=

# Google Maps scraper — varsayılan: compass/google-maps-scraper
APIFY_GOOGLE_MAPS_ACTOR_ID=

# Instagram scraper — varsayılan: apify/instagram-scraper
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
